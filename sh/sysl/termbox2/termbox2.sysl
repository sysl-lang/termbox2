extern "sysl_tb_event_ordinal" c_event_ordinal(kind: int) -> int
extern "sysl_tb_key_ordinal" c_key_ordinal(key: int) -> int
extern "sysl_tb_key_value" c_key_value(ordinal: int) -> int
extern "sysl_tb_key_count" c_key_count() -> int

extern "sysl_tb_mod_alt" c_mod_alt() -> u8
extern "sysl_tb_mod_ctrl" c_mod_ctrl() -> u8
extern "sysl_tb_mod_shift" c_mod_shift() -> u8
extern "sysl_tb_mod_motion" c_mod_motion() -> u8

extern "sysl_tb_poll_event" c_poll_event(t: *int, m: *int, k: *int, ch: *u32, w: *int, h: *int,
                                         x: *int, y: *int) -> int
extern "sysl_tb_peek_event" c_peek_event(timeout_ms: int, t: *int, m: *int, k: *int, ch: *u32,
                                         w: *int, h: *int, x: *int, y: *int) -> int

extern "sysl_tb_print" c_print(x: int, y: int, fg: u64, bg: u64, s: *u8, out_w: *u64) -> int

// The bytes behind a `*u8` that C promises is NUL-terminated static storage, as a `string`.
//
// termbox's own strings -- `tb_strerror`, `tb_version` -- are ASCII literals in the header, so the
// fallback is unreachable in practice and is here because a decode that cannot fail still has to say
// what it would do.
private from_cstring_or(p: *u8, fallback: string) -> string
    if p == null then
        fallback
    else
        from_cstring(p).unwrap_or(fallback)
end from_cstring_or
