module sh.sysl.termbox2

import sysl.text.{cstring, from_cstring}

// A full-screen terminal interface, bound to termbox2.
//
// **Nothing has to be installed to use this package.** termbox2 is a single-header library and this
// package carries the header; sysl compiles a library's C as part of the build (`15 §7`), so there is
// no `-l` flag, no `pkg-config`, and no `@link` in this header -- there is no external library to
// name. What it does need of the machine is POSIX, which `package.hocon` says.
//
// ==What a termbox program looks like==
//
// A program initializes, draws into a back buffer, presents it, and waits for an event. Nothing is
// written to the terminal until `present`, so a frame arrives whole rather than as a visible sweep
// across the screen:
//
//     init()?
//     set_cell(0, 0, u32('#'), RED | BOLD, DEFAULT)?
//     present()?
//     poll_event()?
//     shutdown()?
//
// **Every drawing call answers a `Result`, and the reason is that a terminal is a resource rather
// than a canvas.** The screen may not exist, the terminal may not be one termbox knows, the write may
// fail. A call before `init` answers `NotInit` rather than doing nothing quietly.
//
// ==The one rule a program has to get right==
//
// **`shutdown` restores the terminal, and a program that leaves without it leaves the terminal
// unusable** -- raw mode on, the cursor hidden, the alternate screen still in front of the reader's
// shell. That is not something the reader can see to fix, since their keystrokes are no longer
// echoed. So `shutdown` belongs on every path out, including the failing ones, which is why the
// example in the README does not use `?` for the drawing calls it makes after `init`.
//
// ==Colours and attributes are one integer==
//
// `fg` and `bg` are `u64`, and a colour is bitwise-or'd with any style attributes wanted:
// `RED | BOLD | UNDERLINE`. That is termbox's own design rather than something added here, and it is
// what makes `set_cell` take two integers instead of a struct. The values are read out of the header
// by the C beside this file, for the reason `15 §7` gives: a `#define` has no symbol, and a number
// transcribed into sysl is a number that was right on one machine.
//
// What the numbers *mean* depends on the output mode -- `RED` in `Normal`, an index in `Color256`, an
// `0xRRGGBB` value in `Truecolor`. `set_output_mode` says which, and the attributes above the colour
// bits work the same in all of them.

// ==================================================================================================
// Errors
// ==================================================================================================

// What went wrong, as termbox reports it.
//
// **The number is kept rather than discarded** so that `message` is termbox's own text for exactly
// this failure, including for a code this binding has not heard of. `kind` is the matchable form.
struct Error
    code: int

    // termbox's own description.
    //
    // **For the failures that carry an `errno` -- `Failed`, `InitOpen`, `ReadFailed`, `PollFailed`,
    // the `Tc*` pair and most of the `Resize*` family -- this is the C library's `strerror` text for
    // that `errno` rather than a sentence about termbox.** So a `Failed` recorded when nothing set
    // `errno` reads as "Undefined error: 0", which is termbox saying it has nothing to add.
    //
    // The bytes are termbox's own storage and the next call to this overwrites them, which costs
    // nothing here because the string is copied out before returning.
    message(self) -> string = from_cstring_or(c_strerror(self.code), "unrecognized error code")

    kind(self) -> ErrorKind = error_kind(c_error_ordinal(self.code))

    // The `errno` in effect when termbox last recorded one. Only some failures set it -- `InitOpen`,
    // `ReadFailed`, `PollFailed`, the `Tc*` pair and the `Resize*` family -- and it is untouched
    // otherwise, so reading it after any other kind answers whatever went before.
    errno(self) -> int = c_last_errno()
end Error

// An `Error` renders as termbox's own sentence for it, so `f"${err}"` and a `main` that results in
// one both say something a reader can act on rather than a number.
impl Display for Error
    display(self, out: *Writer, fmt: FormatSpec) = display_str(self.message(), out, fmt)

// The failures termbox names, for matching on.
//
// **The declaration order IS the agreement with `termbox2.c`**, whose `ORDINAL_` list runs down the
// same names in the same order. Nothing restates it here: the discriminants are implicit, so they are
// 0 upward in declaration order.
//
// `UnknownError` exists because a termbox newer than this binding may report something not listed
// here. Answering it keeps a program running and printing rather than trapping on a number, and
// `Error.code` still carries what termbox gave.
enum ErrorKind
    // The unspecific one, which termbox uses where nothing more precise applies and where the real
    // account is in `errno`. `message` reports that `errno` rather than anything about termbox.
    Failed
    // An escape sequence arrived in pieces and the rest has not been read yet.
    NeedMore
    InitAlready
    // The terminal device would not open. `Error.errno` says why.
    InitOpen
    OutOfMemory
    // No event arrived within the timeout. `peek_event` turns this into `Ok(None)` rather than
    // reporting it, since a timeout is what a caller asked for.
    NoEvent
    // `TERM` is unset, so there is nothing to look a terminal's capabilities up under.
    NoTerm
    // A call before `init`, or after `shutdown`.
    NotInit
    OutOfBounds
    ReadFailed
    ResizeIoctl
    ResizePipe
    ResizeSigaction
    PollFailed
    TcGetAttr
    TcSetAttr
    // `TERM` names a terminal with neither a terminfo entry nor a built-in one.
    UnsupportedTerm
    ResizeWrite
    ResizePoll
    ResizeRead
    ResizeSscanf
    CapCollision
    UnknownError

    // The variant's own name, for a program reporting a failure it did not expect and for the
    // assertion that says which kind it actually got. `Error.message` is the sentence a reader
    // should see; this is the label a *programmer* should.
    name(self) -> string = self match
        Failed           -> "Failed"
        NeedMore         -> "NeedMore"
        InitAlready      -> "InitAlready"
        InitOpen         -> "InitOpen"
        OutOfMemory      -> "OutOfMemory"
        NoEvent          -> "NoEvent"
        NoTerm           -> "NoTerm"
        NotInit          -> "NotInit"
        OutOfBounds      -> "OutOfBounds"
        ReadFailed       -> "ReadFailed"
        ResizeIoctl      -> "ResizeIoctl"
        ResizePipe       -> "ResizePipe"
        ResizeSigaction  -> "ResizeSigaction"
        PollFailed       -> "PollFailed"
        TcGetAttr        -> "TcGetAttr"
        TcSetAttr        -> "TcSetAttr"
        UnsupportedTerm  -> "UnsupportedTerm"
        ResizeWrite      -> "ResizeWrite"
        ResizePoll       -> "ResizePoll"
        ResizeRead       -> "ResizeRead"
        ResizeSscanf     -> "ResizeSscanf"
        CapCollision     -> "CapCollision"
        UnknownError     -> "UnknownError"
end ErrorKind

impl Display for ErrorKind
    display(self, out: *Writer, fmt: FormatSpec) = display_str(self.name(), out, fmt)

// A simple enum carries no `==` of its own (`09 §2`), and comparing two kinds is what a caller
// branching on a failure does. The discriminant is the comparison, in one line rather than twenty.
impl Eq for ErrorKind
    eq(self, rhs: ErrorKind) -> bool = int(self) == int(rhs)
end ErrorKind

private error_kind(ordinal: int) -> ErrorKind = ErrorKind.try(ordinal).unwrap_or(UnknownError)

// **Every termbox entry point answers a negative number for a failure and a non-negative one for an
// answer**, which is what makes these two lines the whole of the error handling. `tb_width` returns
// the width or `TB_ERR_NOT_INIT`; `tb_set_input_mode` returns the mode now in effect or a failure.
// Nothing in the API returns a meaningful negative value.
private ok(rv: int) -> Result[unit, Error] = if rv < 0 then Err(Error(rv)) else Ok(())

private ok_int(rv: int) -> Result[int, Error] = if rv < 0 then Err(Error(rv)) else Ok(rv)

// ==================================================================================================
// Colours and style attributes
// ==================================================================================================

// The eight colours a terminal has had since the 1970s, plus `DEFAULT`, which sends no colour code at
// all and so leaves whatever the reader configured their terminal to use.
//
// **These are the values for `Normal` output mode.** In `Color256` a colour is an index 0..255 and
// `HI_BLACK` is how black is spelled, because 0 means default; in `Truecolor` it is `0xRRGGBB` and
// `rgb` builds one. `set_output_mode` has the whole table.
val DEFAULT: u64 = c_default()
val BLACK: u64   = c_black()
val RED: u64     = c_red()
val GREEN: u64   = c_green()
val YELLOW: u64  = c_yellow()
val BLUE: u64    = c_blue()
val MAGENTA: u64 = c_magenta()
val CYAN: u64    = c_cyan()
val WHITE: u64   = c_white()

// Style attributes, bitwise-or'd onto a colour: `RED | BOLD | UNDERLINE`.
//
// **`REVERSE` and `BRIGHT` work as either `fg` or `bg` and mean the same thing; the rest apply to
// `fg` only and are ignored on `bg`.** Not every terminal implements every one of them, and there is
// no reliable way to ask -- a program that must look right everywhere uses `BOLD`, `UNDERLINE` and
// `REVERSE` and leaves the rest to a setting.
//
// `HI_BLACK` is not a style: it is black in the modes where 0 means default.
val BOLD: u64        = c_bold()
val UNDERLINE: u64   = c_underline()
val REVERSE: u64     = c_reverse()
val ITALIC: u64      = c_italic()
val BLINK: u64       = c_blink()
val HI_BLACK: u64    = c_hi_black()
val BRIGHT: u64      = c_bright()
val DIM: u64         = c_dim()
val STRIKEOUT: u64   = c_strikeout()
val UNDERLINE_2: u64 = c_underline_2()
val OVERLINE: u64    = c_overline()
val INVISIBLE: u64   = c_invisible()

// A 24-bit colour for `Truecolor` output mode, which is what the mode's `0xRRGGBB` means written out.
//
// This is arithmetic rather than a constant out of the header, so it is here rather than in the C:
// there is no `#define` to read, and the layout is the mode's definition.
rgb(r: u8, g: u8, b: u8) -> u64 = (u64(r) << 16u64) | (u64(g) << 8u64) | u64(b)

// ==================================================================================================
// Starting and stopping
// ==================================================================================================

// Take over the terminal. Equivalent to `init_file("/dev/tty")`, which is the controlling terminal
// rather than standard output -- so a program whose output is being piped still draws on the screen.
//
// **`shutdown` has to be reached on every path out**, including the failing ones. See the note at the
// top of this file: a program that exits without it leaves the reader with a terminal in raw mode and
// no echo, which they cannot see to fix.
init() -> Result[unit, Error] = ok(c_init())

// Take over the terminal named by a path, which is `init`'s answer to a program with more than one.
init_file(path: string) -> Result[unit, Error]
    val p = cstring(path)

    ok(c_init_file(p.ptr))
end init_file

// Take over a terminal already open, reading and writing the same descriptor.
init_fd(fd: int) -> Result[unit, Error] = ok(c_init_fd(fd))

// The same, reading one descriptor and writing another.
//
// **Neither has to be a terminal.** Where neither is, termbox skips `tcgetattr` and `ioctl` entirely
// and the screen is zero by zero -- which is not useful for drawing, and is exactly what makes the
// lifecycle testable off a terminal. See `tests.sysl`.
init_rwfd(rfd: int, wfd: int) -> Result[unit, Error] = ok(c_init_rwfd(rfd, wfd))

// Give the terminal back: raw mode off, the cursor shown, the alternate screen dropped.
shutdown() -> Result[unit, Error] = ok(c_shutdown())

// ==================================================================================================
// The screen
// ==================================================================================================

// How many columns and rows there are. Both answer `NotInit` before `init`.
//
// **They are not fixed for the life of the program.** A `Resize` event carries the new pair, and a
// program that cached these at startup draws in the wrong places from then on.
//
// **After an `init_rwfd` where neither descriptor is a terminal there is no size to report**, and
// both answer `Failed` rather than a number -- termbox never asked, because there was nothing to ask.
// A program in that state can still init, present and shut down; every cell is out of bounds.
width() -> Result[int, Error] = ok_int(c_width())

height() -> Result[int, Error] = ok_int(c_height())

// Empty the back buffer, filling it with spaces in the attributes `set_clear_attrs` last named.
clear() -> Result[unit, Error] = ok(c_clear())

// What `clear` fills with. `DEFAULT`/`DEFAULT` until told otherwise.
set_clear_attrs(fg: u64, bg: u64) -> Result[unit, Error] = ok(c_set_clear_attrs(fg, bg))

// Send the back buffer to the terminal, and this is the only call that writes anything.
//
// **Only the cells that changed are sent**, which is what keeps a full-screen redraw from flickering
// and is the reason a termbox program may cheerfully rewrite every cell every frame.
present() -> Result[unit, Error] = ok(c_present())

// Forget what the terminal is believed to be showing, so the next `present` sends every cell.
//
// For a program that shelled out to something that drew on the screen, or that changed output mode
// and wants the whole screen reinterpreted at once rather than as cells happen to be touched.
invalidate() -> Result[unit, Error] = ok(c_invalidate())

// Put the cursor somewhere and show it. Hidden is the state after `init`, which is what a full-screen
// program usually wants; an editor wants it at the insertion point.
set_cursor(x: int, y: int) -> Result[unit, Error] = ok(c_set_cursor(x, y))

hide_cursor() -> Result[unit, Error] = ok(c_hide_cursor())

// ==================================================================================================
// Drawing
// ==================================================================================================

// One cell of the back buffer: a codepoint and its two attributes.
//
// A codepoint that is not printable is drawn as U+FFFD. A codepoint two columns wide -- most CJK, and
// much emoji -- takes the cell after it as well, so the next thing a caller sets should be two
// columns along; anything set in the cell between is ignored.
set_cell(x: int, y: int, ch: u32, fg: u64, bg: u64) -> Result[unit, Error] =
    ok(c_set_cell(x, y, ch, fg, bg))

// A string, left to right from `x`, in one pair of attributes. Answers how many columns it took.
//
// **The width answered is columns rather than bytes or codepoints**, so a line of CJK measures twice
// its length in characters and a combining mark measures nothing. That is what a caller laying out a
// second thing beside this one needs, and it is why this returns a number at all.
//
// A start out of bounds is `OutOfBounds`; a string that *runs* out of bounds is drawn as far as it
// fits and the rest is dropped. A newline is honoured, though the width answered is the width the
// string would have had on one line.
print_at(x: int, y: int, fg: u64, bg: u64, s: string) -> Result[usize, Error]
    val text = cstring(s)

    var w: u64 = 0u64

    val rv = c_print(x, y, fg, bg, text.ptr, &w)

    if rv < 0 then Err(Error(rv)) else Ok(usize(w))
end print_at

// Raw bytes straight to the terminal, around the cell buffer entirely.
//
// For an escape sequence termbox has no call for -- setting the window title, say. **It does not go
// through the back buffer**, so termbox does not know the screen changed and will not repair it;
// pair it with `invalidate` if it drew anything. The bytes are buffered like everything else, so
// `present` is what puts them on the wire.
//
// **This answers `NotInit` before `init`, where termbox's own `tb_send` does not check and appends to
// a buffer that `init` is about to discard.** The divergence is deliberate: every neighbouring call
// here reports the mistake, and a caller who reaches this has a bug either way -- one reported at the
// call beats one that surfaces as bytes that never arrived. `termbox2.c` says the same at the shim.
send(bytes: []const u8) -> Result[unit, Error]
    if bytes.len == 0usize then
        Ok(())
    else
        ok(c_send(&bytes[0], bytes.len))
end send

// ==================================================================================================
// Input and output modes
// ==================================================================================================

// How a lone escape byte is read, and whether the mouse is reported.
//
// A terminal sends `\x1b` both for the Escape key and as the first byte of every arrow, function and
// mouse sequence, and nothing in the stream distinguishes them. The two readings are the whole of
// this choice:
//
//   - **`alt = false`** -- an escape that matches no sequence is the Escape key. The default.
//   - **`alt = true`** -- an escape that matches no sequence modifies the key after it, which is how
//     a terminal sends Alt-x. The cost is that pressing Escape alone reports nothing until the next
//     keystroke arrives to be modified.
//
// `mouse` is independent of both and turns `Mouse` events on.
struct InputMode
    alt: bool
    mouse: bool
end InputMode

// Choose how input is read.
//
// **Setting a mode and asking which one is in effect are two calls**, and that is termbox's shape
// rather than a choice made here: one entry point does both, and it tells them apart by being handed
// `TB_INPUT_CURRENT`. Splitting them is what lets each answer the thing it is actually about.
set_input_mode(m: InputMode) -> Result[unit, Error] =
    ok(c_set_input_mode(c_input_value(if m.alt then 1 else 0, if m.mouse then 1 else 0)))

// What input mode is in effect, without changing it.
input_mode() -> Result[InputMode, Error]
    val rv = c_set_input_mode(c_input_current())

    if rv < 0 then
        Err(Error(rv))
    else
        Ok(InputMode(c_input_is_alt(rv) != 0, c_input_has_mouse(rv) != 0))
end input_mode

// What the numbers in `fg` and `bg` mean.
//
// **A cell's attributes are not translated when the mode changes.** `RED` in `Normal` is the number 2,
// which in `Truecolor` is a very dark blue; a program that switches modes has to redraw. Cells
// already on the screen keep what they were sent until the front buffer is cleared, so `invalidate`
// is what makes a switch take effect everywhere at once.
enum OutputMode
    // The eight colours and `DEFAULT`, which is where this module's colour constants come from.
    Normal
    // An index 0..255: `HI_BLACK` then 1..7 as in `Normal`, 8..15 their bright versions, 16..231 a
    // six-by-six-by-six colour cube, and 232..255 a grey ramp.
    Color256
    // The colour cube alone, 1..216, with no offset to remember.
    Color216
    // The grey ramp alone, 1..24.
    Grayscale
    // `0xRRGGBB`, which `rgb` builds. Not every terminal has it, and there is no reliable way to ask.
    Truecolor
    UnknownOutput

    name(self) -> string = self match
        Normal        -> "Normal"
        Color256      -> "Color256"
        Color216      -> "Color216"
        Grayscale     -> "Grayscale"
        Truecolor     -> "Truecolor"
        UnknownOutput -> "UnknownOutput"
end OutputMode

impl Eq for OutputMode
    eq(self, rhs: OutputMode) -> bool = int(self) == int(rhs)
end OutputMode

impl Display for OutputMode
    display(self, out: *Writer, fmt: FormatSpec) = display_str(self.name(), out, fmt)

// Choose what the numbers mean. Two calls rather than one, for the reason `set_input_mode` gives.
//
// **`UnknownOutput` is refused** -- it is the answer to "what mode is this?" for a number this
// binding does not recognize, and not a mode anything can be put into. Asking for it answers
// `Failed`.
set_output_mode(m: OutputMode) -> Result[unit, Error] = ok(c_set_output_mode(c_output_value(int(m))))

// What output mode is in effect, without changing it.
output_mode() -> Result[OutputMode, Error]
    val rv = c_set_output_mode(c_output_current())

    if rv < 0 then
        Err(Error(rv))
    else
        Ok(OutputMode.try(c_output_ordinal(rv)).unwrap_or(UnknownOutput))
end output_mode

// ==================================================================================================
// Events
// ==================================================================================================

// What kind of thing happened.
enum EventKind
    Keyboard
    // The terminal changed size. `Event.w` and `Event.h` are the new one, and every cached width is
    // now wrong.
    Resize
    // Only ever delivered with `InputMode.mouse` on.
    Mouse
    UnknownEvent

    name(self) -> string = self match
        Keyboard     -> "Keyboard"
        Resize       -> "Resize"
        Mouse        -> "Mouse"
        UnknownEvent -> "UnknownEvent"
end EventKind

impl Eq for EventKind
    eq(self, rhs: EventKind) -> bool = int(self) == int(rhs)
end EventKind

impl Display for EventKind
    display(self, out: *Writer, fmt: FormatSpec) = display_str(self.name(), out, fmt)

// A named key, as against a character the reader typed.
//
// **`Event.key` and `Event.ch` are alternatives, and exactly one of them carries the keystroke.** A
// printable character arrives as `ch`, with `key` left at `Nul`; a key with no character -- an arrow,
// a function key, Escape, most control keys -- arrives as `key`, with `ch` left at zero.
//
// **Several of these share one byte, because the terminal sends one byte for what the reader thinks
// are two keys.** Backspace and Ctrl-H are both 0x08; Tab and Ctrl-I are both 0x09; Enter and Ctrl-M
// are both 0x0d; Escape and Ctrl-3 and Ctrl-[ are all 0x1b. Only one name can be answered for one
// byte, so this list keeps the one a reader is likelier to have meant and the comments say what was
// lost. A program cannot tell the two apart, and neither can the terminal.
//
// **The declaration order IS the agreement with `termbox2.c`**, whose `ORDINAL_` list runs down the
// same names in the same order.
enum Key
    // 0x00 -- Ctrl-Space, and also Ctrl-2 and Ctrl-~, which send the same byte. It is *also* what
    // `Event.key` holds when the event carries a codepoint in `ch` instead, so the two are told apart
    // by `ch`: zero for the key, nonzero for a character.
    Nul
    CtrlA
    CtrlB
    // 0x03. A terminal in raw mode does not turn this into a signal, so a termbox program that wants
    // Ctrl-C to mean "quit" has to say so itself -- and a program that forgets has taken away the
    // reader's usual way out.
    CtrlC
    CtrlD
    CtrlE
    CtrlF
    CtrlG
    // 0x08, and also Ctrl-H. Note that most terminals send `Backspace2` for the backspace key.
    Backspace
    // 0x09, and also Ctrl-I.
    Tab
    CtrlJ
    CtrlK
    CtrlL
    // 0x0d, and also Ctrl-M.
    Enter
    CtrlN
    CtrlO
    CtrlP
    CtrlQ
    CtrlR
    CtrlS
    CtrlT
    CtrlU
    CtrlV
    CtrlW
    CtrlX
    CtrlY
    CtrlZ
    // 0x1b, and also Ctrl-3 and Ctrl-[. What a lone one means depends on `InputMode.alt`.
    Esc
    // 0x1c, and also Ctrl-4.
    CtrlBackslash
    // 0x1d, and also Ctrl-5.
    CtrlRightBracket
    // 0x1e, and also Ctrl-^.
    Ctrl6
    // 0x1f, and also Ctrl-7 and Ctrl-_.
    CtrlSlash
    // 0x20. The space bar arrives here rather than as the codepoint for a space.
    Space
    // 0x7f, and also Ctrl-8. **This is what the backspace key actually sends on most terminals**, so
    // a program handling only `Backspace` handles the key almost nowhere.
    Backspace2
    F1
    F2
    F3
    F4
    F5
    F6
    F7
    F8
    F9
    F10
    F11
    F12
    Insert
    Delete
    Home
    End
    PageUp
    PageDown
    Up
    Down
    Left
    Right
    // Shift-Tab.
    BackTab
    // The mouse buttons, delivered as `Mouse` events with the position in `Event.x` and `Event.y`.
    MouseLeft
    MouseRight
    MouseMiddle
    MouseRelease
    MouseWheelUp
    MouseWheelDown
    // A key this binding has no name for. `Event.raw_key` still carries the number termbox gave.
    UnknownKey

    // The variant's own name, which is what a program logging a keystroke it did not handle wants,
    // and what a failed assertion should say. It is not a *label for a reader* -- "CtrlRightBracket"
    // is this list's spelling rather than anything a keyboard has printed on it.
    name(self) -> string = self match
        Nul              -> "Nul"
        CtrlA            -> "CtrlA"
        CtrlB            -> "CtrlB"
        CtrlC            -> "CtrlC"
        CtrlD            -> "CtrlD"
        CtrlE            -> "CtrlE"
        CtrlF            -> "CtrlF"
        CtrlG            -> "CtrlG"
        Backspace        -> "Backspace"
        Tab              -> "Tab"
        CtrlJ            -> "CtrlJ"
        CtrlK            -> "CtrlK"
        CtrlL            -> "CtrlL"
        Enter            -> "Enter"
        CtrlN            -> "CtrlN"
        CtrlO            -> "CtrlO"
        CtrlP            -> "CtrlP"
        CtrlQ            -> "CtrlQ"
        CtrlR            -> "CtrlR"
        CtrlS            -> "CtrlS"
        CtrlT            -> "CtrlT"
        CtrlU            -> "CtrlU"
        CtrlV            -> "CtrlV"
        CtrlW            -> "CtrlW"
        CtrlX            -> "CtrlX"
        CtrlY            -> "CtrlY"
        CtrlZ            -> "CtrlZ"
        Esc              -> "Esc"
        CtrlBackslash    -> "CtrlBackslash"
        CtrlRightBracket -> "CtrlRightBracket"
        Ctrl6            -> "Ctrl6"
        CtrlSlash        -> "CtrlSlash"
        Space            -> "Space"
        Backspace2       -> "Backspace2"
        F1               -> "F1"
        F2               -> "F2"
        F3               -> "F3"
        F4               -> "F4"
        F5               -> "F5"
        F6               -> "F6"
        F7               -> "F7"
        F8               -> "F8"
        F9               -> "F9"
        F10              -> "F10"
        F11              -> "F11"
        F12              -> "F12"
        Insert           -> "Insert"
        Delete           -> "Delete"
        Home             -> "Home"
        End              -> "End"
        PageUp           -> "PageUp"
        PageDown         -> "PageDown"
        Up               -> "Up"
        Down             -> "Down"
        Left             -> "Left"
        Right            -> "Right"
        BackTab          -> "BackTab"
        MouseLeft        -> "MouseLeft"
        MouseRight       -> "MouseRight"
        MouseMiddle      -> "MouseMiddle"
        MouseRelease     -> "MouseRelease"
        MouseWheelUp     -> "MouseWheelUp"
        MouseWheelDown   -> "MouseWheelDown"
        UnknownKey       -> "UnknownKey"
end Key

impl Eq for Key
    eq(self, rhs: Key) -> bool = int(self) == int(rhs)
end Key

impl Display for Key
    display(self, out: *Writer, fmt: FormatSpec) = display_str(self.name(), out, fmt)

// The number termbox reports for a named key -- the inverse of what an event carries.
//
// For a program that reads "F5" out of a configuration file and wants to compare it against what
// arrives, or that prints the code for a key it did not expect. `UnknownKey` has no code, which is
// what the `Option` is for.
key_code(k: Key) -> Option[int]
    val code = c_key_value(int(k))

    if code < 0 then None else Some(code)
end key_code

// Something the reader did.
//
// Which fields mean anything depends on `kind`:
//
//   - `Keyboard` -- `key` or `ch`, and the modifiers.
//   - `Resize` -- `w` and `h`.
//   - `Mouse` -- `key`, which is one of the `Mouse*` variants, and `x` and `y`.
//
// The rest are zero, and reading one of them is reading a number that means nothing rather than
// getting an error.
struct Event
    kind: EventKind

    // The named key, or `Nul` when `ch` carries the keystroke instead.
    key: Key

    // The codepoint the reader typed, or zero when `key` names the keystroke instead.
    ch: u32

    // What termbox gave for the key before it was named, kept so that a key this binding answers
    // `UnknownKey` for is still identifiable.
    raw_key: int

    // The modifiers, as bits. Read them with the four methods below rather than by hand -- the masks
    // are `#define`s in the header, so they are C's to know and not this side's.
    mods: u8

    // The new size, on a `Resize`.
    w: int
    h: int

    // Where the mouse was, on a `Mouse`.
    x: int
    y: int

    // **`ctrl` and `shift` are only ever set on the arrow keys**, and `alt` only in `InputMode.alt`.
    // A control key elsewhere arrives as a `Ctrl*` variant of `Key` rather than as a modifier on a
    // letter, which is the terminal's doing and not termbox's: Ctrl-A is one byte, and no byte says
    // "A with control held".
    alt(self) -> bool = (self.mods & c_mod_alt()) != 0u8

    ctrl(self) -> bool = (self.mods & c_mod_ctrl()) != 0u8

    shift(self) -> bool = (self.mods & c_mod_shift()) != 0u8

    // The mouse moved with a button down. Only on a `Mouse` event.
    motion(self) -> bool = (self.mods & c_mod_motion()) != 0u8
end Event

// Wait for something to happen.
//
// **A resize can interrupt the wait**, in which case this answers `PollFailed` with `EINTR` in
// `Error.errno` and nothing has gone wrong -- calling again is the right response.
poll_event() -> Result[Event, Error]
    var t: int  = 0
    var m: int  = 0
    var k: int  = 0
    var ch: u32 = 0u32
    var w: int  = 0
    var h: int  = 0
    var x: int  = 0
    var y: int  = 0

    val rv = c_poll_event(&t, &m, &k, &ch, &w, &h, &x, &y)

    if rv < 0 then Err(Error(rv)) else Ok(event_of(t, m, k, ch, w, h, x, y))
end poll_event

// The same, giving up after `timeout_ms` milliseconds.
//
// **A timeout is `Ok(None)` rather than an error**, because it is what the caller asked for. That is
// the whole reason this answers an `Option`: a program driving an animation asks for events with a
// short timeout and expects most of them to come back empty.
peek_event(timeout_ms: int) -> Result[Option[Event], Error]
    var t: int  = 0
    var m: int  = 0
    var k: int  = 0
    var ch: u32 = 0u32
    var w: int  = 0
    var h: int  = 0
    var x: int  = 0
    var y: int  = 0

    val rv = c_peek_event(timeout_ms, &t, &m, &k, &ch, &w, &h, &x, &y)

    if rv >= 0 then
        Ok(Some(event_of(t, m, k, ch, w, h, x, y)))
    elif Error(rv).kind() == NoEvent then
        Ok(None)
    else
        Err(Error(rv))
end peek_event

private event_of(t: int, m: int, k: int, ch: u32, w: int, h: int, x: int, y: int) -> Event =
    Event(EventKind.try(c_event_ordinal(t)).unwrap_or(UnknownEvent),
          Key.try(c_key_ordinal(k)).unwrap_or(UnknownKey),
          ch, k, u8(m), w, h, x, y)

// The two descriptors termbox reads, for a program running its own `select` or `poll` loop over
// several sources at once. Either becoming readable means `poll_event` will answer without blocking.
//
// The first is the terminal; the second is the pipe the `SIGWINCH` handler writes to, which is how a
// resize wakes a wait that is otherwise blocked on the keyboard.
fds() -> Result[(int, int), Error]
    var tty: int    = 0
    var resize: int = 0

    val rv = c_get_fds(&tty, &resize)

    if rv < 0 then Err(Error(rv)) else Ok((tty, resize))
end fds

// ==================================================================================================
// What was built, and what the terminal can do
// ==================================================================================================

// termbox's own version string.
version() -> string = from_cstring_or(c_version(), "unknown")

// How wide an attribute is, in bits -- 64 here, which is what buys `Truecolor` and the four style
// attributes above the first eight.
//
// **This is a compile-time option of the vendored header**, and it is reported at run time precisely
// because nothing else can check it: a `#define` is invisible to the linker, so a mismatch between
// what the header was compiled with and what a caller assumes would compile, link, and pass the wrong
// number of bytes. The tests here assert this against the width of the constants for that reason.
attr_width() -> int = c_attr_width()

// Whether this build has `Truecolor` output mode. True, and it follows from `attr_width` being at
// least 32.
has_truecolor() -> bool = c_has_truecolor() != 0

// Whether this build has grapheme-cluster cells. **False, deliberately** -- the package does not set
// `TB_OPT_EGC`, so `tb_set_cell_ex` and `tb_extend_cell` are absent and are not bound. `termbox2.c`
// says why.
has_egc() -> bool = c_has_egc() != 0

// How many columns a codepoint occupies: 2 for most CJK and much emoji, 0 for a combining mark, 1 for
// everything ordinary, and -1 for a codepoint that has no printed form at all.
//
// **This is termbox's own measurement rather than `sysl.text.columns`**, and it is the one that
// decides layout on the screen, so a program placing something beside a string it drew should ask
// here. The two use different Unicode tables and can disagree at the edges; termbox's answer is the
// one that was used to lay the cells out.
wcwidth(ch: u32) -> int = c_wcwidth(ch)

// Whether a codepoint has a printed form. One that does not is drawn as U+FFFD.
is_printable(ch: u32) -> bool = c_iswprint(ch) != 0

// The `errno` in effect when termbox last recorded one, which is the same number `Error.errno`
// answers. Only some failures set it.
last_errno() -> int = c_last_errno()

// ==================================================================================================
// The C
// ==================================================================================================

// Most of these are termbox's own symbols, named directly: an `extern` states the symbol it wants,
// and a shim that only forwarded would be a second place for an argument order to be wrong. The
// `sysl_tb_` ones are the three things C alone can reach -- the `#define`s, `struct tb_event`, and
// `tb_print_ex`'s `size_t` out-parameter. `termbox2.c` says which is which and why.

extern "tb_init" c_init() -> int
extern "tb_init_file" c_init_file(path: *u8) -> int
extern "tb_init_fd" c_init_fd(fd: int) -> int
extern "tb_init_rwfd" c_init_rwfd(rfd: int, wfd: int) -> int
extern "tb_shutdown" c_shutdown() -> int

extern "tb_width" c_width() -> int
extern "tb_height" c_height() -> int
extern "tb_clear" c_clear() -> int
extern "tb_set_clear_attrs" c_set_clear_attrs(fg: u64, bg: u64) -> int
extern "tb_present" c_present() -> int
extern "tb_invalidate" c_invalidate() -> int
extern "tb_set_cursor" c_set_cursor(x: int, y: int) -> int
extern "tb_hide_cursor" c_hide_cursor() -> int
extern "tb_set_cell" c_set_cell(x: int, y: int, ch: u32, fg: u64, bg: u64) -> int
extern "sysl_tb_send" c_send(buf: *u8, n: usize) -> int

extern "tb_set_input_mode" c_set_input_mode(mode: int) -> int
extern "tb_set_output_mode" c_set_output_mode(mode: int) -> int
extern "tb_get_fds" c_get_fds(tty: *int, resize: *int) -> int

extern "tb_last_errno" c_last_errno() -> int
extern "tb_strerror" c_strerror(code: int) -> *u8
extern "tb_has_truecolor" c_has_truecolor() -> int
extern "tb_has_egc" c_has_egc() -> int
extern "tb_attr_width" c_attr_width() -> int
extern "tb_version" c_version() -> *u8
extern "tb_iswprint" c_iswprint(ch: u32) -> int
extern "tb_wcwidth" c_wcwidth(ch: u32) -> int

extern "sysl_tb_error_ordinal" c_error_ordinal(code: int) -> int

extern "sysl_tb_default" c_default() -> u64
extern "sysl_tb_black" c_black() -> u64
extern "sysl_tb_red" c_red() -> u64
extern "sysl_tb_green" c_green() -> u64
extern "sysl_tb_yellow" c_yellow() -> u64
extern "sysl_tb_blue" c_blue() -> u64
extern "sysl_tb_magenta" c_magenta() -> u64
extern "sysl_tb_cyan" c_cyan() -> u64
extern "sysl_tb_white" c_white() -> u64

extern "sysl_tb_bold" c_bold() -> u64
extern "sysl_tb_underline" c_underline() -> u64
extern "sysl_tb_reverse" c_reverse() -> u64
extern "sysl_tb_italic" c_italic() -> u64
extern "sysl_tb_blink" c_blink() -> u64
extern "sysl_tb_hi_black" c_hi_black() -> u64
extern "sysl_tb_bright" c_bright() -> u64
extern "sysl_tb_dim" c_dim() -> u64
extern "sysl_tb_strikeout" c_strikeout() -> u64
extern "sysl_tb_underline_2" c_underline_2() -> u64
extern "sysl_tb_overline" c_overline() -> u64
extern "sysl_tb_invisible" c_invisible() -> u64

extern "sysl_tb_input_current" c_input_current() -> int
extern "sysl_tb_input_value" c_input_value(alt: int, mouse: int) -> int
extern "sysl_tb_input_is_alt" c_input_is_alt(mode: int) -> int
extern "sysl_tb_input_has_mouse" c_input_has_mouse(mode: int) -> int

extern "sysl_tb_output_current" c_output_current() -> int
