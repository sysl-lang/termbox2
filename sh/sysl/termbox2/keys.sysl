module sh.sysl.termbox2

import sh.sysl.termbox2.c

// The named keys, and the two matches pairing them with the numbers termbox reports.
//
// **This is a third of the package by weight and it is one table**, which is why it is a file of
// its own: a reader looking for what `Event.key` can hold, or checking that a key is paired with the
// constant it should be, wants this and nothing else. It was two `switch`es in C until `c const`
// arrived, agreeing with the declaration order below by convention and with nothing comparing them.

// A named key, as against a character the reader typed.
//
// **`Event.key` and `Event.ch` are alternatives, and exactly one of them carries the keystroke.** A
// printable character arrives as `ch`, with `key` left at `Nul`; a key with no character -- an arrow,
// a function key, Escape, most control keys -- arrives as `key`, with `ch` left at zero.
//
// **Several of these share one byte, because the terminal sends one byte for what the reader thinks
// are two keys.** Backspace and Ctrl-H are both 0x08; Tab and Ctrl-I are both 0x09; Enter and Ctrl-M
// are both 0x0d; Escape and Ctrl-3 and Ctrl-[ are all 0x1b. Only one name can be answered for one
// byte, so this list keeps the one a reader is likelier to have meant and the comments say what was
// lost. A program cannot tell the two apart, and neither can the terminal.
//
// **That the aliases are absent is now enforced rather than merely intended**: `of` matches on
// termbox's own constants, and two arms standing for one value is a refusal (`09 §2`). The C `switch`
// this replaced would have taken the first and said nothing.
enum Key
    // 0x00 -- Ctrl-Space, and also Ctrl-2 and Ctrl-~, which send the same byte. It is *also* what
    // `Event.key` holds when the event carries a codepoint in `ch` instead, so the two are told apart
    // by `ch`: zero for the key, nonzero for a character.
    Nul
    CtrlA
    CtrlB
    // 0x03. A terminal in raw mode does not turn this into a signal, so a termbox program that wants
    // Ctrl-C to mean "quit" has to say so itself -- and a program that forgets has taken away the
    // reader's usual way out.
    CtrlC
    CtrlD
    CtrlE
    CtrlF
    CtrlG
    // 0x08, and also Ctrl-H. Note that most terminals send `Backspace2` for the backspace key.
    Backspace
    // 0x09, and also Ctrl-I.
    Tab
    CtrlJ
    CtrlK
    CtrlL
    // 0x0d, and also Ctrl-M.
    Enter
    CtrlN
    CtrlO
    CtrlP
    CtrlQ
    CtrlR
    CtrlS
    CtrlT
    CtrlU
    CtrlV
    CtrlW
    CtrlX
    CtrlY
    CtrlZ
    // 0x1b, and also Ctrl-3 and Ctrl-[. What a lone one means depends on `InputMode.alt`.
    Esc
    // 0x1c, and also Ctrl-4.
    CtrlBackslash
    // 0x1d, and also Ctrl-5.
    CtrlRightBracket
    // 0x1e, and also Ctrl-^.
    Ctrl6
    // 0x1f, and also Ctrl-7 and Ctrl-_.
    CtrlSlash
    // 0x20. The space bar arrives here rather than as the codepoint for a space.
    Space
    // 0x7f, and also Ctrl-8. **This is what the backspace key actually sends on most terminals**, so
    // a program handling only `Backspace` handles the key almost nowhere.
    Backspace2
    F1
    F2
    F3
    F4
    F5
    F6
    F7
    F8
    F9
    F10
    F11
    F12
    Insert
    Delete
    Home
    End
    PageUp
    PageDown
    Up
    Down
    Left
    Right
    // Shift-Tab.
    BackTab
    // The mouse buttons, delivered as `Mouse` events with the position in `Event.x` and `Event.y`.
    MouseLeft
    MouseRight
    MouseMiddle
    MouseRelease
    MouseWheelUp
    MouseWheelDown
    // A key this binding has no name for. `Event.raw_key` still carries the number termbox gave.
    UnknownKey

    // The number termbox reports for this key -- the inverse of what an event carries.
    //
    // For a program that reads "F5" out of a configuration file and wants to compare it against what
    // arrives, or that prints the code for a key it did not expect. **`UnknownKey` has no code**,
    // which is what the `Option` is for; every key termbox names is non-negative, so the sentinel
    // below cannot be mistaken for one.
    code(self) -> Option[int]
        val value = self match
            Nul              -> c.KEY_CTRL_TILDE
            CtrlA            -> c.KEY_CTRL_A
            CtrlB            -> c.KEY_CTRL_B
            CtrlC            -> c.KEY_CTRL_C
            CtrlD            -> c.KEY_CTRL_D
            CtrlE            -> c.KEY_CTRL_E
            CtrlF            -> c.KEY_CTRL_F
            CtrlG            -> c.KEY_CTRL_G
            Backspace        -> c.KEY_BACKSPACE
            Tab              -> c.KEY_TAB
            CtrlJ            -> c.KEY_CTRL_J
            CtrlK            -> c.KEY_CTRL_K
            CtrlL            -> c.KEY_CTRL_L
            Enter            -> c.KEY_ENTER
            CtrlN            -> c.KEY_CTRL_N
            CtrlO            -> c.KEY_CTRL_O
            CtrlP            -> c.KEY_CTRL_P
            CtrlQ            -> c.KEY_CTRL_Q
            CtrlR            -> c.KEY_CTRL_R
            CtrlS            -> c.KEY_CTRL_S
            CtrlT            -> c.KEY_CTRL_T
            CtrlU            -> c.KEY_CTRL_U
            CtrlV            -> c.KEY_CTRL_V
            CtrlW            -> c.KEY_CTRL_W
            CtrlX            -> c.KEY_CTRL_X
            CtrlY            -> c.KEY_CTRL_Y
            CtrlZ            -> c.KEY_CTRL_Z
            Esc              -> c.KEY_ESC
            CtrlBackslash    -> c.KEY_CTRL_BACKSLASH
            CtrlRightBracket -> c.KEY_CTRL_RSQ_BRACKET
            Ctrl6            -> c.KEY_CTRL_6
            CtrlSlash        -> c.KEY_CTRL_SLASH
            Space            -> c.KEY_SPACE
            Backspace2       -> c.KEY_BACKSPACE2
            F1               -> c.KEY_F1
            F2               -> c.KEY_F2
            F3               -> c.KEY_F3
            F4               -> c.KEY_F4
            F5               -> c.KEY_F5
            F6               -> c.KEY_F6
            F7               -> c.KEY_F7
            F8               -> c.KEY_F8
            F9               -> c.KEY_F9
            F10              -> c.KEY_F10
            F11              -> c.KEY_F11
            F12              -> c.KEY_F12
            Insert           -> c.KEY_INSERT
            Delete           -> c.KEY_DELETE
            Home             -> c.KEY_HOME
            End              -> c.KEY_END
            PageUp           -> c.KEY_PGUP
            PageDown         -> c.KEY_PGDN
            Up               -> c.KEY_ARROW_UP
            Down             -> c.KEY_ARROW_DOWN
            Left             -> c.KEY_ARROW_LEFT
            Right            -> c.KEY_ARROW_RIGHT
            BackTab          -> c.KEY_BACK_TAB
            MouseLeft        -> c.KEY_MOUSE_LEFT
            MouseRight       -> c.KEY_MOUSE_RIGHT
            MouseMiddle      -> c.KEY_MOUSE_MIDDLE
            MouseRelease     -> c.KEY_MOUSE_RELEASE
            MouseWheelUp     -> c.KEY_MOUSE_WHEEL_UP
            MouseWheelDown   -> c.KEY_MOUSE_WHEEL_DOWN
            UnknownKey       -> -1

        if value < 0 then None else Some(value)
    end code

    // Which key a number termbox reported is, and `UnknownKey` for one this list does not name --
    // which is what keeps a program running against a terminal sending something newer.
    of(value: int) -> Key = value match
        c.KEY_CTRL_TILDE       -> Nul
        c.KEY_CTRL_A           -> CtrlA
        c.KEY_CTRL_B           -> CtrlB
        c.KEY_CTRL_C           -> CtrlC
        c.KEY_CTRL_D           -> CtrlD
        c.KEY_CTRL_E           -> CtrlE
        c.KEY_CTRL_F           -> CtrlF
        c.KEY_CTRL_G           -> CtrlG
        c.KEY_BACKSPACE        -> Backspace
        c.KEY_TAB              -> Tab
        c.KEY_CTRL_J           -> CtrlJ
        c.KEY_CTRL_K           -> CtrlK
        c.KEY_CTRL_L           -> CtrlL
        c.KEY_ENTER            -> Enter
        c.KEY_CTRL_N           -> CtrlN
        c.KEY_CTRL_O           -> CtrlO
        c.KEY_CTRL_P           -> CtrlP
        c.KEY_CTRL_Q           -> CtrlQ
        c.KEY_CTRL_R           -> CtrlR
        c.KEY_CTRL_S           -> CtrlS
        c.KEY_CTRL_T           -> CtrlT
        c.KEY_CTRL_U           -> CtrlU
        c.KEY_CTRL_V           -> CtrlV
        c.KEY_CTRL_W           -> CtrlW
        c.KEY_CTRL_X           -> CtrlX
        c.KEY_CTRL_Y           -> CtrlY
        c.KEY_CTRL_Z           -> CtrlZ
        c.KEY_ESC              -> Esc
        c.KEY_CTRL_BACKSLASH   -> CtrlBackslash
        c.KEY_CTRL_RSQ_BRACKET -> CtrlRightBracket
        c.KEY_CTRL_6           -> Ctrl6
        c.KEY_CTRL_SLASH       -> CtrlSlash
        c.KEY_SPACE            -> Space
        c.KEY_BACKSPACE2       -> Backspace2
        c.KEY_F1               -> F1
        c.KEY_F2               -> F2
        c.KEY_F3               -> F3
        c.KEY_F4               -> F4
        c.KEY_F5               -> F5
        c.KEY_F6               -> F6
        c.KEY_F7               -> F7
        c.KEY_F8               -> F8
        c.KEY_F9               -> F9
        c.KEY_F10              -> F10
        c.KEY_F11              -> F11
        c.KEY_F12              -> F12
        c.KEY_INSERT           -> Insert
        c.KEY_DELETE           -> Delete
        c.KEY_HOME             -> Home
        c.KEY_END              -> End
        c.KEY_PGUP             -> PageUp
        c.KEY_PGDN             -> PageDown
        c.KEY_ARROW_UP         -> Up
        c.KEY_ARROW_DOWN       -> Down
        c.KEY_ARROW_LEFT       -> Left
        c.KEY_ARROW_RIGHT      -> Right
        c.KEY_BACK_TAB         -> BackTab
        c.KEY_MOUSE_LEFT       -> MouseLeft
        c.KEY_MOUSE_RIGHT      -> MouseRight
        c.KEY_MOUSE_MIDDLE     -> MouseMiddle
        c.KEY_MOUSE_RELEASE    -> MouseRelease
        c.KEY_MOUSE_WHEEL_UP   -> MouseWheelUp
        c.KEY_MOUSE_WHEEL_DOWN -> MouseWheelDown
        _                      -> UnknownKey

    // The variant's own name, which is what a program logging a keystroke it did not handle wants,
    // and what a failed assertion should say. It is not a *label for a reader* -- "CtrlRightBracket"
    // is this list's spelling rather than anything a keyboard has printed on it.
    name(self) -> string = self match
        Nul              -> "Nul"
        CtrlA            -> "CtrlA"
        CtrlB            -> "CtrlB"
        CtrlC            -> "CtrlC"
        CtrlD            -> "CtrlD"
        CtrlE            -> "CtrlE"
        CtrlF            -> "CtrlF"
        CtrlG            -> "CtrlG"
        Backspace        -> "Backspace"
        Tab              -> "Tab"
        CtrlJ            -> "CtrlJ"
        CtrlK            -> "CtrlK"
        CtrlL            -> "CtrlL"
        Enter            -> "Enter"
        CtrlN            -> "CtrlN"
        CtrlO            -> "CtrlO"
        CtrlP            -> "CtrlP"
        CtrlQ            -> "CtrlQ"
        CtrlR            -> "CtrlR"
        CtrlS            -> "CtrlS"
        CtrlT            -> "CtrlT"
        CtrlU            -> "CtrlU"
        CtrlV            -> "CtrlV"
        CtrlW            -> "CtrlW"
        CtrlX            -> "CtrlX"
        CtrlY            -> "CtrlY"
        CtrlZ            -> "CtrlZ"
        Esc              -> "Esc"
        CtrlBackslash    -> "CtrlBackslash"
        CtrlRightBracket -> "CtrlRightBracket"
        Ctrl6            -> "Ctrl6"
        CtrlSlash        -> "CtrlSlash"
        Space            -> "Space"
        Backspace2       -> "Backspace2"
        F1               -> "F1"
        F2               -> "F2"
        F3               -> "F3"
        F4               -> "F4"
        F5               -> "F5"
        F6               -> "F6"
        F7               -> "F7"
        F8               -> "F8"
        F9               -> "F9"
        F10              -> "F10"
        F11              -> "F11"
        F12              -> "F12"
        Insert           -> "Insert"
        Delete           -> "Delete"
        Home             -> "Home"
        End              -> "End"
        PageUp           -> "PageUp"
        PageDown         -> "PageDown"
        Up               -> "Up"
        Down             -> "Down"
        Left             -> "Left"
        Right            -> "Right"
        BackTab          -> "BackTab"
        MouseLeft        -> "MouseLeft"
        MouseRight       -> "MouseRight"
        MouseMiddle      -> "MouseMiddle"
        MouseRelease     -> "MouseRelease"
        MouseWheelUp     -> "MouseWheelUp"
        MouseWheelDown   -> "MouseWheelDown"
        UnknownKey       -> "UnknownKey"
end Key

impl Display for Key
    display(self, out: *Writer, fmt: FormatSpec) = display_str(self.name(), out, fmt)
