module sh.sysl.termbox2
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_temp_dir, read_text, remove_dir_all, write_text}
import sysl.text.{Search, from_utf8_lossy, grapheme_columns, repeat}

// What this binding claims, run by `sysl test .`.
//
// ==What is covered, and what a terminal would be needed for==
//
// **Nothing here draws on a screen, because a test suite has no terminal to draw on.** termbox asks
// the terminal for its size with `ioctl`, and a descriptor that is not a terminal has none to give --
// so `init` against an ordinary file leaves a screen of no width, on which every cell is out of
// bounds. That is not a limitation of the tests so much as the honest state of a program with no
// terminal, and the lifecycle tests below pin exactly that state rather than pretending otherwise.
//
// Covering `set_cell` and `present` for real would need a pseudo-terminal, which needs `openpt`,
// `TIOCSWINSZ` and a `struct winsize` -- macros and a layout, so more C, and C in this package is C
// every consumer compiles. It was judged not worth shipping test scaffolding to every program that
// draws a menu. The README says the same thing where a reader will see it.
//
// ==What IS covered, and why each case was chosen==
//
// The failures a binding has are not the failures a library has. A shim that dropped an argument, or
// a table whose two halves were paired wrongly, still compiles, still links, and still answers
// something. So:
//
//   - **The compile-time options.** `TB_OPT_ATTR_W`, `TB_OPT_EGC` and `TB_OPT_LIBC_WCHAR` are
//     `#define`s, invisible to the linker, and each of them changes what the library *is*. A test is
//     the only thing that can notice one did not arrive. They matter twice over now: `c/options.h`
//     is included by the implementation *and* by the translation unit the `c const` block is measured
//     from, and the values of the style attributes depend on it.
//   - **Both directions of every table.** `Key.code` and `Key.of` are two matches over one
//     correspondence, so every variant is round-tripped through both -- which catches an arm that is
//     missing or paired with the wrong constant. A key value otherwise only arrives from a terminal
//     somebody is typing at, so nothing else here could see it.
//   - **That the right C name was asked for.** A `c const` cannot hold a number no header defines,
//     but it can perfectly well hold the wrong one -- so the keys whose values the header states
//     outright are pinned against those statements.
//   - **The error path across many entry points**, since that is the one path a program with no
//     terminal can reach in full.
//   - **What termbox actually wrote**, by pointing it at a file and reading the file back. That is
//     the only assertion here about bytes leaving the process, and it is what proves `send`'s
//     pointer and length crossed intact.

// `TERM` is what termbox looks a terminal's capabilities up under, and `init` fails with `NoTerm`
// when it is unset and `UnsupportedTerm` when it names something with neither a terminfo entry nor a
// built-in one. Neither is a fact about this binding, and a suite that passed at a developer's
// terminal and failed under a build runner would be reporting the runner.
//
// So the tests set it, to a name termbox carries built-in capabilities for. `setenv` is POSIX and
// this package already requires POSIX; it is named here rather than in the binding because a library
// has no business changing its consumer's environment.
extern "setenv" c_setenv(name: *u8, value: *u8, overwrite: int) -> int

private with_term() = c_setenv(c"TERM", c"xterm", 1)

// Where a test points termbox: a file in a directory of the test's own, made the first time the test
// asks, since `sysl test` runs tests several at once and two sharing one file would read each other's
// bytes. Every test that makes it removes it (`scratch_gone`).
private var scratch_dir: string = ""

private scratch() -> string
    if scratch_dir == ""
        scratch_dir = make_temp_dir("sysl-termbox2").expect("a scratch directory can be made")

    s"$scratch_dir/out"

private scratch_gone() = remove_dir_all(scratch_dir).expect("the scratch file can be removed")

// A headless termbox, initialized against an ordinary file, which is the only kind of `init` a suite
// can make. The file has to exist first, because `init_file` opens rather than creates.
private headless()
    with_term()
    write_text(scratch(), "").expect("the scratch file can be created")
    init_file(scratch()).expect("termbox initializes against a file")

private done()
    shutdown().expect("termbox shuts down")
    scratch_gone()

// -- The compile-time options ----------------------------------------------------------------------

// **This is the `REG_EXTENDED` case of this package**: `TB_OPT_ATTR_W` is a `#define`, so nothing
// about it is visible to the linker, and a header compiled at 16 bits while this side assumed 64
// would compile cleanly and pass the wrong number of bytes for every colour.
//
// It also decides the *values* of the twelve style attributes, and the `c const` block is measured
// from a translation unit of its own -- so the second assertion below is what says that unit saw the
// same option the implementation did.
//
// `tb_attr_width` reports what the header was actually compiled with, which is what makes the
// mismatch findable at all. The second assertion is the same claim from the other end: `INVISIBLE`
// only exists at 64 bits, and it does not fit in 32.
@test
the_attribute_width_the_header_was_built_with_is_the_one_this_side_assumes() =
    assert_eq(attr_width(), 64)
    assert(INVISIBLE > 0xffffffffu64, "a 64-bit-only attribute is above the 32-bit ones")
    assert(has_truecolor(), "truecolor follows from an attribute width of at least 32")

// The other options, stated in `c/options.h`.
//
// `has_egc` being true is what makes `tb_set_cell_ex` and `tb_extend_cell` present, and `set_cluster`
// rests on them.
@test
grapheme_clusters_are_on_and_the_binding_says_so() =
    assert(has_egc(), "TB_OPT_EGC is set, so a cell can hold a whole grapheme cluster")

// **`TB_OPT_LIBC_WCHAR` is the option this catches, and it catches it by measuring a character.**
// Unset -- as it is here -- termbox measures width with its own Unicode tables. Set, it would use
// libc's `wcwidth(3)`, which answers -1 for every non-ASCII codepoint until the program has called
// `setlocale(3)` with a UTF-8 locale, and no sysl program does. So a package built the other way
// would lay CJK out one column wide and this assertion is what says it did not.
@test
a_codepoints_width_is_measured_in_columns_by_termboxs_own_tables() =
    assert_eq(wcwidth(0x61), 1)          // 'a'
    assert_eq(wcwidth(0x4e00), 2)        // the CJK ideograph for "one"
    assert_eq(wcwidth(0x1f600), 2)       // a grinning face
    assert_eq(wcwidth(0x0301), 0)        // a combining acute accent occupies nothing
    assert_eq(wcwidth(0x07), -1)         // and a bell has no printed form at all

@test
a_codepoint_with_no_printed_form_is_not_printable() =
    assert(is_printable(0x61), "a letter is printable")
    assert(is_printable(0x4e00), "so is an ideograph")
    assert(!is_printable(0x07), "a bell is not")
    assert(!is_printable(0x00), "and neither is a NUL")

// -- Colours and attributes ------------------------------------------------------------------------

// Nothing here can check that `RED` is red -- that would need a terminal to be red on. What it can
// check is the *shape* the two families have to have for a bitwise-or to mean anything, which is what
// a shim returning one constant where another was meant would break.
@test
a_colour_and_a_style_occupy_different_bits() =
    assert_eq(DEFAULT, 0)

    val colours = [BLACK, RED, GREEN, YELLOW, BLUE, MAGENTA, CYAN, WHITE]
    val styles  = [BOLD, UNDERLINE, REVERSE, ITALIC, BLINK, HI_BLACK, BRIGHT, DIM,
                   STRIKEOUT, UNDERLINE_2, OVERLINE, INVISIBLE]

    for i in 0..<colours.len
        assert(colours[i] != 0, "no colour is the default")

        for j in 0..<colours.len
            if i != j then assert(colours[i] != colours[j], "the eight colours are eight numbers")

        for s in styles
            assert(colours[i] < s, "every colour is below every style bit")
            assert((colours[i] & s) == 0, "so or-ing the two loses neither")

    for i in 0..<styles.len
        assert((styles[i] & (styles[i] - 1)) == 0, "a style attribute is one bit")

        for j in 0..<styles.len
            if i != j then assert(styles[i] != styles[j], "and the twelve are twelve bits")

// The one place a colour is built rather than read out of the header, so this is arithmetic of this
// package's own and is testable outright.
@test
rgb_packs_the_channels_where_truecolor_reads_them() =
    assert_eq(rgb(255, 0, 0), 0xff0000)
    assert_eq(rgb(0, 255, 0), 0x00ff00)
    assert_eq(rgb(0, 0, 255), 0x0000ffu64)
    assert_eq(rgb(1, 2, 3), 0x010203)
    assert_eq(rgb(0, 0, 0), DEFAULT)

// -- The key table ---------------------------------------------------------------------------------

// **Two matches over one correspondence, so every variant goes through both.**
//
// This is the only test that can see the key table at all: a key value otherwise arrives from a
// terminal somebody is typing at, and there is none here. An arm that is missing or paired with the
// wrong constant fails one of the assertions below -- and either is a mistake that compiles, links,
// and quietly reports the wrong key for the rest of the package's life.
//
// **The bound comes from the enum itself**, by asking `try` for each ordinal until it has none, so
// adding a key cannot leave the loop testing the old list. That used to be a C function reporting the
// length of a hand-written list; now the list is the enum and nothing has to report anything.
@test
every_named_key_round_trips_through_both_matches() =
    var codes: Buf[int] = buf()
    var i               = 0

    while Key.try(i).is_some()
        val k = Key.try(i).expect("the loop stops where the variants do")

        if k != UnknownKey then
            val code = k.code().expect("every named key has a number")

            assert_eq(Key.of(code), k)

            for j in 0..<codes.len()
                assert(codes[j] != code, "and no two of them are the same number")

            codes.push(code)

        i += 1

    assert(codes.len() > 60, "the table names the keys a terminal has")
    assert_eq(int(codes.len()), i - 1)   // every variant but `UnknownKey` named a number

// A value no key has answers `UnknownKey` rather than landing on whichever arm a fall-through would
// have reached. `!` is an ordinary printable character, which arrives in `Event.ch` and never in
// `Event.key`, so it is exactly the sort of number that must not be named.
@test
a_key_value_the_table_does_not_name_is_unknown() =
    assert_eq(Key.of(0x21), UnknownKey)
    assert_eq(Key.of(0x1000), UnknownKey)
    assert(UnknownKey.code().is_none(), "and `UnknownKey` has no code to answer with")

// The inverse, on the two shapes of key: one from the ASCII range and one the terminal synthesizes.
// Escape's code is shared with Ctrl-3 and Ctrl-[, which is why `Esc` is the name kept.
@test
key_code_answers_what_an_event_would_have_carried() =
    val esc = Esc.code().expect("Escape has a code")
    val up  = Up.code().expect("the up arrow has a code")

    assert(esc < 0x80, "an ASCII key is the byte the terminal sent")
    assert(up > 0xff, "and a terminal-dependent one is above every byte")
    assert(esc != up, "which are not the same number")

// **That the right C name was asked for, which no round trip can tell.** `code` and `of` agree
// perfectly if a variant is paired with the wrong `c const` in *both* of them, and `c const` only
// promises the number is whatever the header says for the name written down -- so these are the
// numbers `termbox2.h` states outright, checked against it.
//
// The function keys and the arrows are counted down from `0xffff`, which is the header's own way of
// keeping them clear of every byte a terminal can send.
@test
the_keys_the_header_gives_a_number_have_that_number() =
    assert_eq(Nul.code().expect("Ctrl-Space has a code"), 0x00)
    assert_eq(Esc.code().expect("Escape has a code"), 0x1b)
    assert_eq(Space.code().expect("the space bar has a code"), 0x20)
    assert_eq(Backspace2.code().expect("the backspace key has a code"), 0x7f)
    assert_eq(F1.code().expect("F1 has a code"), 0xffff)
    assert_eq(Up.code().expect("the up arrow has a code"), 0xffff - 18)
    assert_eq(BackTab.code().expect("Shift-Tab has a code"), 0xffff - 22)
    assert_eq(MouseLeft.code().expect("the left button has a code"), 0xffff - 23)

// -- Errors ------------------------------------------------------------------------------------------

// **Every entry point before `init` answers `NotInit`, and nothing quietly does nothing.** This is
// the widest sweep the suite can make: a dozen functions, each reached through its own `extern`, each
// having to carry a negative number back and turn it into the same kind.
//
// `peek_event` is the interesting one -- it has two negative answers to tell apart, and a timeout is
// not what happened here.
@test
every_call_before_init_says_the_library_is_not_initialized() =
    assert_eq(width().unwrap_err().kind(), NotInit)
    assert_eq(height().unwrap_err().kind(), NotInit)
    assert_eq(clear().unwrap_err().kind(), NotInit)
    assert_eq(present().unwrap_err().kind(), NotInit)
    assert_eq(invalidate().unwrap_err().kind(), NotInit)
    assert_eq(hide_cursor().unwrap_err().kind(), NotInit)
    assert_eq(set_cursor(0, 0).unwrap_err().kind(), NotInit)
    assert_eq(set_cell(0, 0, 0x61, DEFAULT, DEFAULT).unwrap_err().kind(), NotInit)
    assert_eq(set_clear_attrs(RED, BLUE).unwrap_err().kind(), NotInit)
    assert_eq(print_at(0, 0, DEFAULT, DEFAULT, "x").unwrap_err().kind(), NotInit)
    assert_eq(send("x".bytes).unwrap_err().kind(), NotInit)
    assert_eq(fds().unwrap_err().kind(), NotInit)
    assert_eq(poll_event().unwrap_err().kind(), NotInit)
    assert_eq(peek_event(0).unwrap_err().kind(), NotInit)
    assert_eq(shutdown().unwrap_err().kind(), NotInit)

// A failure that carries an `errno`, which is a different path through `Error` from the ones above:
// the kind comes from termbox and the *message* comes from the C library's `strerror`.
@test
a_failure_that_carries_an_errno_reports_the_c_librarys_words() =
    with_term()

    val e = init_file("/no/such/terminal/anywhere").unwrap_err()

    assert_eq(e.kind(), InitOpen)
    assert(e.errno() != 0, "opening something that is not there set errno")
    assert(e.message() != "", "and the message is the C library's sentence for it")

// Two different failures give two different kinds and two different sentences. A binding that
// answered one code for everything, or that read the message for a code other than the one it was
// given, passes neither half.
@test
two_failures_are_two_answers() =
    with_term()

    val absent = init_file("/no/such/terminal/anywhere").unwrap_err()
    val stopped = width().unwrap_err()

    assert(absent.kind() != stopped.kind(), "a missing device is not an uninitialized library")
    assert(absent.message() != stopped.message(), "and they do not read the same")
    assert(absent.code != stopped.code, "because they are not the same code")

// A code termbox has never issued still answers something, which is what keeps a program running
// against a termbox newer than this binding.
@test
a_code_this_binding_has_not_heard_of_is_other_rather_than_a_trap() =
    val made_up = Error(-9999)

    assert_eq(made_up.kind(), UnknownError)
    assert(made_up.message() != "", "and it still has words for it")

// -- The lifecycle, with no terminal -----------------------------------------------------------------

// **The honest state of a program with no terminal**, which is what a suite has. termbox initializes,
// because a descriptor is all it needs to write to; it has no size, because a size comes from an
// `ioctl` on a terminal and there is none; and so every cell is out of bounds.
//
// Pinning this is worth more than it looks: it is the whole of what distinguishes "termbox refused"
// from "termbox is running and there is nowhere to draw", and a program run under a pipe hits it.
@test
init_against_a_file_succeeds_and_leaves_a_screen_with_no_size() =
    headless()

    assert_eq(width().unwrap_err().kind(), Failed)
    assert_eq(height().unwrap_err().kind(), Failed)
    assert_eq(set_cell(0, 0, 0x61, RED, DEFAULT).unwrap_err().kind(), OutOfBounds)
    assert_eq(print_at(0, 0, RED, DEFAULT, "hello").unwrap_err().kind(), OutOfBounds)

    assert(clear().is_ok(), "clearing a screen of no cells is not a failure")
    assert(present().is_ok(), "and neither is presenting one")

    done()

@test
a_second_init_is_refused_and_a_call_after_shutdown_is_too() =
    headless()

    assert_eq(init_file(scratch()).unwrap_err().kind(), InitAlready)

    done()

    assert_eq(present().unwrap_err().kind(), NotInit)

// The two descriptors a program running its own event loop waits on. Nothing here can make either
// readable; what it can check is that two came back rather than one value twice, which is the shape
// of mistake an out-parameter pair invites.
@test
the_descriptors_to_wait_on_are_two_different_ones() =
    headless()

    val (tty, resize) = fds().expect("the descriptors are available once initialized")

    assert(tty >= 0, "the terminal descriptor is open")
    assert(resize >= 0, "so is the pipe the resize handler writes to")
    assert(tty != resize, "and they are not the same one")

    done()

// **The one assertion here about bytes leaving the process.** `send` hands C a pointer and a length,
// and a shim that dropped the length or passed the wrong pointer would still return `TB_OK`.
//
// The escape sequence is the second half: termbox writes one at `init` -- enter the alternate screen,
// hide the cursor, clear -- so a file holding none would mean the capabilities never loaded, which is
// the failure `NoTerm` exists for and which would otherwise pass silently as a screen nobody looked at.
@test
what_was_sent_is_on_the_far_end_of_the_descriptor() =
    headless()

    send("hello, terminal".bytes).expect("raw bytes are accepted")
    present().expect("present flushes what is buffered")

    // Read before removing, so `done` is not what ends this one.
    shutdown().expect("termbox shuts down")

    val written = read_text(scratch()).expect("the file can be read back")

    scratch_gone()

    assert(written.contains("hello, terminal"), "the bytes sent are the bytes written")
    assert(written.contains("\u{1b}["), "and termbox wrote escape sequences of its own around them")

// -- Modes -------------------------------------------------------------------------------------------

// **Both directions of the output-mode table.** The ordinal crosses one way to choose a mode and the
// other way to report it, so a pair of switches out of step answers the wrong mode -- which nothing
// but a round trip can see, since a mode has no observable effect without a screen.
@test
an_output_mode_set_is_the_output_mode_reported() =
    headless()

    assert_eq(output_mode().expect("a mode is in effect"), Normal)

    for m in [Color256, Color216, Grayscale, Truecolor, Normal]
        set_output_mode(m).expect("the mode is accepted")
        assert_eq(output_mode().expect("and is the one in effect afterwards"), m)

    done()

// `UnknownOutput` is what a number this binding does not recognize is *reported* as, and it is not
// something anything can be put into. A shim answering `Normal` for an ordinal it did not know would
// leave a caller who asked for nonsense believing they had got what they asked for.
@test
a_mode_that_is_not_one_is_refused_rather_than_rounded_to_normal() =
    headless()

    set_output_mode(Color216).expect("a real mode is accepted")

    assert_eq(set_output_mode(UnknownOutput).unwrap_err().kind(), Failed)
    assert_eq(output_mode().expect("and the refusal changed nothing"), Color216)

    done()

// **The input mode is a mask rather than an enumeration**, so this checks composition and
// decomposition rather than a table: two independent bits, four combinations, each recovered.
//
// The `alt`/`esc` pair is the half a shim can get wrong invisibly -- termbox says asking for both
// behaves as if only `esc` had been asked for, so a composition that or-ed them together would report
// `alt = false` for a caller who asked for `alt = true`.
@test
an_input_mode_set_is_the_input_mode_reported() =
    headless()

    val start = input_mode().expect("a mode is in effect")

    assert(!start.alt, "escape means the Escape key until told otherwise")
    assert(!start.mouse, "and the mouse is not reported until asked for")

    for wanted in [InputMode(true, false), InputMode(false, true), InputMode(true, true),
                   InputMode(false, false)]
        set_input_mode(wanted).expect("the mode is accepted")

        val got = input_mode().expect("and is the one in effect afterwards")

        assert_eq(got.alt, wanted.alt)
        assert_eq(got.mouse, wanted.mouse)

    done()

// -- What termbox says about itself -------------------------------------------------------------------

// A string out of static C storage, which is the simplest thing that can cross and is therefore worth
// one assertion: a `*u8` that was never decoded would answer the fallback instead.
@test
the_version_is_termboxs_own() =
    assert(version() != "", "termbox names its version")
    assert(version() != "unknown", "and it is not this binding's fallback")
    assert(version().contains("2."), "the vendored header is a termbox 2")

// -- Grapheme clusters, on a pseudo-terminal -----------------------------------------------------------
//
// A cell can only be set on a screen with a size, and a size comes from `ioctl(TIOCGWINSZ)` on a real
// terminal. `openpty` makes one with the size given, so these tests draw for real: the back buffer is
// read back with `cluster_at`, and the bytes termbox writes are read from the master end.

extern "openpty" c_openpty(master: *int, slave: *int, name: *u8, termp: *u8, winp: *u16) -> int
extern "close" c_close(fd: int) -> int
extern "read" c_read(fd: int, buf: *u8, n: usize) -> isize

private struct Pty
    master: int
    slave: int
end Pty

// A termbox on a 4 row, 12 column pseudo-terminal.
private screen() -> Pty
    with_term()

    var size: [4]u16 = [4, 12, 0, 0]
    var master = 0
    var slave = 0

    assert_eq(c_openpty(&master, &slave, null, null, &size[0]), 0)

    init_fd(slave).expect("termbox initializes on a pseudo-terminal")

    Pty(master, slave)
end screen

// **The master end is closed before `shutdown`.** Restoring the terminal's modes waits for what has
// been written to it to be read, and nothing here reads after the test body; with the master gone the
// wait ends, and the restore may report a hung-up terminal, which is not what any test is about.
private leave(p: Pty)
    c_close(p.master)
    shutdown()
    c_close(p.slave)

@test
a_pseudo_terminal_gives_termbox_the_size_it_was_opened_with() =
    val p = screen()

    assert_eq(width().expect("there is a width"), 12)
    assert_eq(height().expect("and a height"), 4)

    leave(p)

// A plain ASCII cell goes through `set_cell` and reads back as itself, so turning clusters on did not
// change the ordinary path.
@test
an_ascii_cell_is_unchanged() =
    val p = screen()

    set_cell(0, 0, u32('a'), RED, DEFAULT).expect("an ordinary cell is set")

    assert_eq(cluster_at(0, 0).expect("it reads back"), "a")

    leave(p)

// The case that started this: a base letter and a combining acute in one cell.
@test
a_base_and_a_combining_mark_share_one_cell() =
    val p = screen()

    set_cluster(1, 0, "e\u{301}", DEFAULT, DEFAULT).expect("a cluster is set")

    assert_eq(cluster_at(1, 0).expect("it reads back"), "e\u{301}")
    assert_eq(cluster_at(2, 0).expect("and the next cell is untouched"), " ")

    leave(p)

// A single-codepoint cluster takes the same path as `set_cell`.
@test
a_one_codepoint_cluster_is_an_ordinary_cell() =
    val p = screen()

    set_cluster(0, 1, "z", DEFAULT, DEFAULT).expect("set")

    assert_eq(cluster_at(0, 1).expect("read"), "z")

    leave(p)

// Setting a plain codepoint over a cluster replaces it, rather than leaving the old marks behind.
@test
a_plain_set_over_a_cluster_drops_the_marks() =
    val p = screen()

    set_cluster(0, 0, "e\u{301}\u{323}", DEFAULT, DEFAULT).expect("a three codepoint cluster")
    assert_eq(cluster_at(0, 0).expect("read"), "e\u{301}\u{323}")

    set_cell(0, 0, u32('x'), DEFAULT, DEFAULT).expect("overwritten")
    assert_eq(cluster_at(0, 0).expect("read"), "x")

    leave(p)

// `extend_cell` appends to what a cell holds, one codepoint at a time.
@test
extending_a_cell_appends_codepoints() =
    val p = screen()

    set_cell(3, 2, u32('a'), DEFAULT, DEFAULT).expect("a base")
    extend_cell(3, 2, 0x301).expect("first mark")
    assert_eq(cluster_at(3, 2).expect("read"), "a\u{301}")

    extend_cell(3, 2, 0x323).expect("second mark")
    assert_eq(cluster_at(3, 2).expect("read"), "a\u{301}\u{323}")

    leave(p)

// A cluster wider than one cell: a family emoji, seven codepoints, two columns wide and one cell.
@test
an_emoji_sequence_is_one_cell_of_many_codepoints() =
    val p = screen()
    val family = "\u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f467}\u{200d}\u{1f466}"

    set_cluster(0, 0, family, DEFAULT, DEFAULT).expect("a ZWJ sequence is one cluster")

    assert_eq(cluster_at(0, 0).expect("read"), family)
    assert_eq(grapheme_columns(family.bytes), 2)

    leave(p)

// A wide base with a mark, and a flag: other multi-codepoint shapes.
@test
a_wide_base_with_a_mark_and_a_flag_each_fit_a_cell() =
    val p = screen()

    set_cluster(0, 0, "\u{4e16}\u{301}", DEFAULT, DEFAULT).expect("wide base plus mark")
    assert_eq(cluster_at(0, 0).expect("read"), "\u{4e16}\u{301}")

    set_cluster(4, 0, "\u{1f1e8}\u{1f1e6}", DEFAULT, DEFAULT).expect("a flag")
    assert_eq(cluster_at(4, 0).expect("read"), "\u{1f1e8}\u{1f1e6}")

    leave(p)

// What termbox writes for a cluster: all its codepoints, in order, to the terminal.
@test
presenting_a_cluster_writes_all_its_codepoints() =
    val p = screen()

    set_cluster(0, 0, "e\u{301}", DEFAULT, DEFAULT).expect("a cluster")
    present().expect("presented")

    var raw: [1024]u8 = [0; 1024]
    var got = ""

    loop
        val n = c_read(p.master, &raw[0], 1024)

        if n <= 0 then break

        got = got + from_utf8_lossy(raw[..<usize(n)])

        if got.contains("e\u{301}") then break

    assert(got.contains("e\u{301}"), "the base and its mark reach the terminal together")

    leave(p)

// -- Cluster error paths --------------------------------------------------------------------------------

// A cell holds one cluster, so an empty string and a string of several clusters are refused, and the
// refusal writes nothing.
@test
set_cluster_refuses_an_empty_string_and_more_than_one_cluster() =
    val p = screen()

    set_cell(0, 0, u32('k'), DEFAULT, DEFAULT).expect("something to protect")

    assert_eq(set_cluster(0, 0, "", DEFAULT, DEFAULT).unwrap_err().kind(), Failed)
    assert_eq(set_cluster(0, 0, "ab", DEFAULT, DEFAULT).unwrap_err().kind(), Failed)
    assert_eq(set_cluster(0, 0, "e\u{301}x", DEFAULT, DEFAULT).unwrap_err().kind(), Failed)

    assert_eq(cluster_at(0, 0).expect("read"), "k")

    leave(p)

@test
the_cluster_calls_report_out_of_bounds_and_not_init() =
    assert_eq(set_cluster(0, 0, "e\u{301}", DEFAULT, DEFAULT).unwrap_err().kind(), NotInit)
    assert_eq(extend_cell(0, 0, 0x301).unwrap_err().kind(), NotInit)
    assert_eq(cluster_at(0, 0).unwrap_err().kind(), NotInit)

    val p = screen()

    assert_eq(set_cluster(12, 0, "e\u{301}", DEFAULT, DEFAULT).unwrap_err().kind(), OutOfBounds)
    assert_eq(set_cluster(0, 4, "e\u{301}", DEFAULT, DEFAULT).unwrap_err().kind(), OutOfBounds)
    assert_eq(set_cluster(-1, 0, "e\u{301}", DEFAULT, DEFAULT).unwrap_err().kind(), OutOfBounds)
    assert_eq(extend_cell(12, 0, 0x301).unwrap_err().kind(), OutOfBounds)
    assert_eq(cluster_at(0, 4).unwrap_err().kind(), OutOfBounds)

    leave(p)

// -- Bracketed paste, on a pseudo-terminal ---------------------------------------------------------------
//
// What the reader types or pastes is written into the master end, which is exactly where a terminal
// emulator writes it, and the events termbox makes of it are read back with `poll_event`. termbox reads
// at most 64 bytes at a time, so anything longer arrives in several reads whatever the test does.

extern "write" c_write(fd: int, buf: *u8, n: usize) -> isize

private val OPEN = "\u{1b}[200~"
private val CLOSE = "\u{1b}[201~"

private feed(p: Pty, s: string) = assert_eq(c_write(p.master, &s.bytes[0], s.len), isize(s.len))

private bracketed(text: string) -> string = OPEN + text + CLOSE

private next() -> Event = poll_event().expect("an event arrives")

// Nothing to report yet: the bytes so far stop inside a paste.
private nothing_yet() = assert(peek_event(20).expect("a peek").is_none(), "no event before the end marker")

private paste_of(ev: Event) -> string
    assert_eq(ev.kind, Paste)

    ev.text
end paste_of

private typed(ev: Event, ch: char)
    assert_eq(ev.kind, Keyboard)
    assert_eq(ev.ch, u32(ch))

// Everything the terminal was sent so far contains `s`. Blocks until it does, so it is asked only for
// bytes that a flush has already written.
private heard(p: Pty, s: string)
    var raw: [256]u8 = [0; 256]
    var got = ""

    while !got.contains(s)
        val n = c_read(p.master, &raw[0], 256)

        assert(n > 0, "the terminal has more to read")
        got = got + from_utf8_lossy(raw[..<usize(n)])
end heard

// **Off by default**, so a program that never asks sees what it always saw: the opening marker is
// Escape followed by typing, which is the finding that started this.
@test
bracketed_paste_is_off_by_default_and_the_markers_arrive_as_keys() =
    val p = screen()

    feed(p, bracketed("XY"))

    assert_eq(next().key, Esc)
    typed(next(), '[')
    typed(next(), '2')
    typed(next(), '0')
    typed(next(), '0')
    typed(next(), '~')
    typed(next(), 'X')

    leave(p)

@test
enabling_tells_the_terminal_and_a_paste_is_one_event() =
    val p = screen()

    enable_bracketed_paste().expect("bracketed paste turns on")
    heard(p, "\u{1b}[?2004h")

    feed(p, bracketed("hello\nworld\tand a tab\r\n"))

    val ev = next()

    assert_eq(paste_of(ev), "hello\nworld\tand a tab\r\n")
    assert_eq(ev.key, Nul)
    assert_eq(ev.ch, 0)
    assert_eq(ev.mods, 0)
    assert_eq(ev.kind.name(), "Paste")

    leave(p)

// Keys on either side of a paste, in the same write, keep their order and their meaning -- an arrow
// key's sequence is still an arrow key outside the markers.
@test
keys_before_and_after_a_paste_are_unaffected() =
    val p = screen()

    enable_bracketed_paste().expect("on")
    feed(p, "a\u{1b}[A" + bracketed("mid") + "b\u{1b}[A\r")

    typed(next(), 'a')
    assert_eq(next().key, Up)
    assert_eq(paste_of(next()), "mid")
    typed(next(), 'b')
    assert_eq(next().key, Up)
    assert_eq(next().key, Enter)

    leave(p)

// Inside the markers nothing is a key: a lone Escape, an arrow key's sequence, and a near miss of the
// closing marker are all text, and an Escape directly before the real closing marker is too.
@test
a_paste_holding_escapes_is_text() =
    val p = screen()

    enable_bracketed_paste().expect("on")

    val inner = "x\u{1b}y\u{1b}[A\u{1b}[201z\u{1b}[200~\u{1b}"

    feed(p, bracketed(inner))

    assert_eq(paste_of(next()), inner)

    leave(p)

@test
an_empty_paste_and_two_pastes_in_one_read_are_each_one_event() =
    val p = screen()

    enable_bracketed_paste().expect("on")
    feed(p, bracketed("") + bracketed("first") + bracketed("second"))

    assert_eq(paste_of(next()), "")
    assert_eq(paste_of(next()), "first")
    assert_eq(paste_of(next()), "second")

    leave(p)

// The end marker comes in a later write, and so does half of it: `peek_event` reports nothing while
// the paste is open and keeps what it has read.
@test
a_paste_split_across_writes_waits_for_its_end_marker() =
    val p = screen()

    enable_bracketed_paste().expect("on")

    feed(p, OPEN + "one ")
    nothing_yet()
    feed(p, "two\n\u{1b}[20")
    nothing_yet()
    feed(p, "1~z")

    assert_eq(paste_of(next()), "one two\n")
    typed(next(), 'z')

    leave(p)

// The opening marker split in two is still an opening marker, not Escape and typing.
@test
an_opening_marker_split_across_writes_still_opens_a_paste() =
    val p = screen()

    enable_bracketed_paste().expect("on")

    feed(p, "\u{1b}[20")
    nothing_yet()
    feed(p, "0~x" + CLOSE)

    assert_eq(paste_of(next()), "x")

    leave(p)

// One write of 63 typed bytes and a paste: termbox's first read ends on the paste's Escape, which in
// `ESC` mode termbox would report as the Escape key without asking anything else.
@test
an_opening_marker_split_by_a_read_boundary_still_opens_a_paste() =
    val p = screen()

    enable_bracketed_paste().expect("on")
    feed(p, repeat("a", 63) + bracketed("hi"))

    for _ in 0..<63
        typed(next(), 'a')

    assert_eq(paste_of(next()), "hi")

    leave(p)

// `poll_event` waits through every read a paste takes: four hundred bytes are seven of termbox's.
@test
poll_waits_through_the_reads_a_paste_takes() =
    val p = screen()

    enable_bracketed_paste().expect("on")

    val text = repeat("0123456789\n", 36)

    feed(p, bracketed(text) + "q")

    assert_eq(paste_of(next()), text)
    typed(next(), 'q')

    leave(p)

// A mebibyte, written the way a terminal hands a long paste over: in pieces, with the program reading
// between them. The search for the end marker resumes where it stopped, so this is linear; searching
// from the start at every 64-byte read would be eight thousand times the work.
@test
a_large_paste_arrives_whole() =
    val p = screen()

    enable_bracketed_paste().expect("on")

    val text = repeat("the quick brown fox \u{1b}[A jumps\n", 32768)
    val whole = bracketed(text)
    var at: usize = 0

    while at < whole.len
        val end = if at + 512 < whole.len then at + 512 else whole.len

        feed(p, whole[at..<end])
        at = end

        if at < whole.len then assert(peek_event(1).expect("a peek").is_none(), "still open")

    assert_eq(paste_of(next()), text)

    leave(p)

// Bytes that are not UTF-8 are still delivered, as U+FFFD, rather than losing the paste.
@test
a_paste_with_bytes_that_are_not_utf8_arrives_with_replacements() =
    val p = screen()

    enable_bracketed_paste().expect("on")

    var raw: [14]u8 = [0x1b, '[', '2', '0', '0', '~', 0xff, 'a', 0x1b, '[', '2', '0', '1', '~']

    assert_eq(c_write(p.master, &raw[0], 14), 14)
    assert_eq(paste_of(next()), "\u{fffd}a")

    leave(p)

// In `alt` mode an Escape before a key is a modifier, and a paste is still a paste.
@test
a_paste_in_alt_mode_with_mouse_on_is_still_one_event() =
    val p = screen()

    set_input_mode(InputMode(true, true)).expect("alt and mouse")
    enable_bracketed_paste().expect("on")
    feed(p, "\u{1b}x" + bracketed("p\u{1b}q"))

    val alt_x = next()

    typed(alt_x, 'x')
    assert(alt_x.alt(), "Escape before a key is Alt")
    assert_eq(paste_of(next()), "p\u{1b}q")

    leave(p)

@test
disabling_tells_the_terminal_and_a_paste_is_typing_again() =
    val p = screen()

    enable_bracketed_paste().expect("on")
    disable_bracketed_paste().expect("and off")
    heard(p, "\u{1b}[?2004l")

    feed(p, bracketed("k"))

    assert_eq(next().key, Esc)
    typed(next(), '[')

    leave(p)

// `shutdown` turns bracketed paste off, so the shell the program returns to is not left receiving
// markers -- and a program that never turned it on sends nothing about it at all.
@test
shutdown_turns_bracketed_paste_off_and_only_if_it_was_on() =
    headless()
    enable_bracketed_paste().expect("on")
    shutdown().expect("termbox shuts down")

    val on = read_text(scratch()).expect("the terminal's bytes")

    assert(on.contains("\u{1b}[?2004h"), "turned on")
    assert(on.contains("\u{1b}[?2004l"), "and off again at shutdown")
    assert(on.index_of("\u{1b}[?2004h").unwrap() < on.index_of("\u{1b}[?2004l").unwrap(), "in that order")

    headless()
    shutdown().expect("termbox shuts down")

    assert(!read_text(scratch()).expect("the bytes").contains("?2004"), "never mentioned when never on")

    scratch_gone()

// A second session starts with it off again, whatever the first did.
@test
a_new_session_starts_with_bracketed_paste_off() =
    val first = screen()

    enable_bracketed_paste().expect("on")
    leave(first)

    val p = screen()

    feed(p, bracketed("k"))
    assert_eq(next().key, Esc)

    leave(p)

@test
bracketed_paste_before_init_is_not_init() =
    assert_eq(enable_bracketed_paste().unwrap_err().kind(), NotInit)
    assert_eq(disable_bracketed_paste().unwrap_err().kind(), NotInit)
